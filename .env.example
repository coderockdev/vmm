# Default script/content-plan generation provider.
# "openai" = ChatGPT (recommended). "mock" needs zero setup (offline, no cost).
# Each generation in the UI can override per-run.
AI_PROVIDER=openai

# Needed only for AI_PROVIDER=anthropic (or when overriding a generation to
# "Claude" in the UI).
ANTHROPIC_API_KEY=
ANTHROPIC_SCRIPT_MODEL=claude-opus-5

# Needed only for AI_PROVIDER=openai (or when overriding a generation to
# "ChatGPT" in the UI). Same key as OPENAI_API_KEY used below for cover art.
OPENAI_SCRIPT_MODEL=gpt-4o

# Needed only for AI_PROVIDER=gemini (or when overriding a generation to
# "Gemini" in the UI).
GEMINI_API_KEY=
GEMINI_SCRIPT_MODEL=gemini-3.8-flash

# Default narration engine for channels that don't override it.
# "local" uses macOS `say` (zero setup). "elevenlabs" needs the key below.
TTS_PROVIDER=local

# Only needed if you want to try ElevenLabs narration (channel voice engine
# dropdown, or per-generation override in the channel page).
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Needed for "Gerar capa com IA" / Portadas (OpenAI Images — most complete keyed engine).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: force a default Portadas engine (openai | gemini | pollinations |
# pollinations-turbo | pollinations-gptimage). Without this, picks OpenAI if
# keyed, else Gemini if keyed, else free Pollinations Flux.
# IMAGE_PROVIDER=pollinations

# Optional Gemini/Imagen for Portadas when GEMINI_API_KEY is set above.
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Thumbnail / image cost estimates (USD per image). Pollinations is always $0.
# PRICING_OPENAI_IMAGE_PER_IMAGE=0.04
# PRICING_GEMINI_IMAGE_PER_IMAGE=0.04

# Persistence backend. "sqlite" (default) needs zero setup. "supabase" needs
# the two vars below (run supabase/schema.sql in your project's SQL editor
# first) — see src/core/supabaseClient.ts.
DB_PROVIDER=sqlite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generated-file storage (narration audio, cover art, rendered video).
# "local" (default) writes to ./data — zero setup, but needs a writable,
# persistent filesystem (your own machine, not Vercel). Leave STORAGE_PROVIDER
# unset to auto-detect: it switches to "supabase" automatically whenever
# VERCEL is set, OR whenever DB_PROVIDER=supabase is set (the two are meant
# to travel together — a shared cloud database with per-machine local files
# doesn't make sense). Set STORAGE_PROVIDER explicitly only to override that
# default. Needs the same SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above, plus
# a public Storage bucket (default name "media") — see src/core/storage/index.ts.
STORAGE_PROVIDER=
SUPABASE_STORAGE_BUCKET=media

# ---- YouTube Data API (OAuth) — one Google account per VMM channel ----
# Create OAuth Client ID (Web) in Google Cloud Console with redirect:
#   http://localhost:3000/api/youtube/oauth/callback
# Enable "YouTube Data API v3". Prefer these names (aliases YOUTUBE_OAUTH_* also work):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
# 32-byte key as base64 — generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Optional public app URL (OAuth callback redirect). Defaults to request origin.
# APP_URL=http://localhost:3000
